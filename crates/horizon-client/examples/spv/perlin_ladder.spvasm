; Hand-written SPIR-V for the Perlin density ladder (R1-R6).
;
; Assembled with: spirv-as --target-env vulkan1.3
; Run through wgpu's SPIR-V passthrough (Vulkan backend), so no naga
; translation sits between this text and the driver.
;
; Contract this module exists to test:
;   * every floating-point add/sub/mul/div carries NoContraction, so the
;     driver must not contract or reassociate anything;
;   * every site where the Rust reference uses f32::mul_add is an explicit
;     GLSL.std.450 Fma, so it fuses exactly once, in the same place;
;   * no fast-math flags are set anywhere.
;
; The optional float-controls header (see perlin_spirv_probe.rs) adds
;   OpCapability FloatControls2
;   OpCapability DenormPreserve
;   OpCapability SignedZeroInfNanPreserve
;   OpExtension "SPV_KHR_float_controls2"
;   OpExecutionMode %main DenormPreserve 32
;   OpExecutionMode %main SignedZeroInfNanPreserve 32
; which needs VK_KHR_shader_float_controls2 on the device.
;
; Inputs mirror crates/horizon-core/src/density/program.rs:
;   Point { vec4<i32> cell; vec4<f32> off; f32 fade_y; f32 amp; vec2<f32> pad; }
; Output: 8 f32 per sample, one per rung:
;   0 R1 leaf                1 R2 alpha 0        2 R2 alpha 0.375
;   3 R2 alpha 1             4 R3 spline         5 R4 coordinate offset
;   6 R5 add/mul/blend       7 R6 trivial router root
OpCapability Shader
%g = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %gid %points %output %perm %grads
OpExecutionMode %main LocalSize 64 1 1
; Every floating-point operation is non-contractible.
OpDecorate %gt NoContraction
OpDecorate %fq1 NoContraction
OpDecorate %fq2 NoContraction
OpDecorate %fr NoContraction
OpDecorate %lsub NoContraction
OpDecorate %dx1 NoContraction
OpDecorate %dy1 NoContraction
OpDecorate %dz1 NoContraction
OpDecorate %swidth NoContraction
OpDecorate %snum NoContraction
OpDecorate %salpha NoContraction
OpDecorate %sdelta NoContraction
OpDecorate %srl NoContraction
OpDecorate %s1ma NoContraction
OpDecorate %st NoContraction
OpDecorate %r2diff NoContraction
OpDecorate %shx NoContraction
OpDecorate %shy NoContraction
OpDecorate %shz NoContraction
OpDecorate %sox NoContraction
OpDecorate %soy NoContraction
OpDecorate %soz NoContraction
OpDecorate %r5a NoContraction
OpDecorate %r5b NoContraction
OpDecorate %r5diff NoContraction
OpDecorate %r6 NoContraction
OpDecorate %m0 NoContraction
OpDecorate %m1 NoContraction
OpDecorate %m2 NoContraction
OpDecorate %m3 NoContraction
OpDecorate %m4 NoContraction
OpDecorate %m5 NoContraction
OpDecorate %m6 NoContraction
OpDecorate %m7 NoContraction
OpDecorate %bufPoints Block
OpMemberDecorate %bufPoints 0 Offset 0
OpDecorate %rtPoint ArrayStride 48
OpDecorate %bufFloats Block
OpMemberDecorate %bufFloats 0 Offset 0
OpDecorate %rtf ArrayStride 4
OpDecorate %bufU32 Block
OpMemberDecorate %bufU32 0 Offset 0
OpDecorate %rtu ArrayStride 4
OpDecorate %bufV4f Block
OpMemberDecorate %bufV4f 0 Offset 0
OpDecorate %rtv4f ArrayStride 16
OpMemberDecorate %Point 0 Offset 0
OpMemberDecorate %Point 1 Offset 16
OpMemberDecorate %Point 2 Offset 32
OpMemberDecorate %Point 3 Offset 36
OpMemberDecorate %Point 4 Offset 40
OpDecorate %gid BuiltIn GlobalInvocationId
OpDecorate %points DescriptorSet 0
OpDecorate %points Binding 0
OpDecorate %points NonWritable
OpDecorate %output DescriptorSet 0
OpDecorate %output Binding 1
OpDecorate %perm DescriptorSet 0
OpDecorate %perm Binding 2
OpDecorate %perm NonWritable
OpDecorate %grads DescriptorSet 0
OpDecorate %grads Binding 3
OpDecorate %grads NonWritable

%void = OpTypeVoid
%fnv = OpTypeFunction %void
%u32 = OpTypeInt 32 0
%i32 = OpTypeInt 32 1
%bool = OpTypeBool
%f32 = OpTypeFloat 32
%v2f = OpTypeVector %f32 2
%v4f = OpTypeVector %f32 4
%v4i = OpTypeVector %i32 4
%v3u = OpTypeVector %u32 3
%Point = OpTypeStruct %v4i %v4f %f32 %f32 %v2f
%rtPoint = OpTypeRuntimeArray %Point
%rtf = OpTypeRuntimeArray %f32
%rtu = OpTypeRuntimeArray %u32
%rtv4f = OpTypeRuntimeArray %v4f
%bufPoints = OpTypeStruct %rtPoint
%bufFloats = OpTypeStruct %rtf
%bufU32 = OpTypeStruct %rtu
%bufV4f = OpTypeStruct %rtv4f
%pPoints = OpTypePointer StorageBuffer %bufPoints
%pFloats = OpTypePointer StorageBuffer %bufFloats
%pU32buf = OpTypePointer StorageBuffer %bufU32
%pV4fbuf = OpTypePointer StorageBuffer %bufV4f
%pPoint = OpTypePointer StorageBuffer %Point
%pI32 = OpTypePointer StorageBuffer %i32
%pU32 = OpTypePointer StorageBuffer %u32
%pF32 = OpTypePointer StorageBuffer %f32
%pV4f = OpTypePointer StorageBuffer %v4f
%pV4i = OpTypePointer StorageBuffer %v4i
%pInV3u = OpTypePointer Input %v3u
%fn_i32_i32 = OpTypeFunction %i32 %i32
%fn_f32_f32 = OpTypeFunction %f32 %f32
%fn_fff = OpTypeFunction %f32 %f32 %f32 %f32
%fn_gdot = OpTypeFunction %f32 %i32 %f32 %f32 %f32
%fn_perlin = OpTypeFunction %f32 %v4i %v4f %f32

%c0i = OpConstant %i32 0
%c1i = OpConstant %i32 1
%ci1 = OpConstant %i32 1
%ci2 = OpConstant %i32 2
%ci3 = OpConstant %i32 3
%ci4 = OpConstant %i32 4
%ci7 = OpConstant %i32 7
%ci15 = OpConstant %i32 15
%ci255 = OpConstant %i32 255
%u0 = OpConstant %u32 0
%u1 = OpConstant %u32 1
%u2 = OpConstant %u32 2
%u3 = OpConstant %u32 3
%u4 = OpConstant %u32 4
%u5 = OpConstant %u32 5
%u6 = OpConstant %u32 6
%u7 = OpConstant %u32 7
%uN = OpConstant %u32 60000
%c0 = OpConstant %f32 0.0
%c1 = OpConstant %f32 1.0
%c2 = OpConstant %f32 2.0
%cm2 = OpConstant %f32 -2.0
%c6 = OpConstant %f32 6.0
%c10 = OpConstant %f32 10.0
%cm15 = OpConstant %f32 -15.0
%c0375 = OpConstant %f32 0.375
%cm025 = OpConstant %f32 -0.25
%cm05 = OpConstant %f32 -0.5
%c0125 = OpConstant %f32 0.125
%cm075 = OpConstant %f32 -0.75
%c0875 = OpConstant %f32 0.875
%c075 = OpConstant %f32 0.75

%points = OpVariable %pPoints StorageBuffer
%output = OpVariable %pFloats StorageBuffer
%perm = OpVariable %pU32buf StorageBuffer
%grads = OpVariable %pV4fbuf StorageBuffer
%gid = OpVariable %pInV3u Input

; permute(i) = permutation[i & 255]
%permute = OpFunction %i32 None %fn_i32_i32
%pi = OpFunctionParameter %i32
%plab = OpLabel
%pmask = OpBitwiseAnd %i32 %pi %ci255
%pe = OpAccessChain %pU32 %perm %c0i %pmask
%praw = OpLoad %u32 %pe
%pval = OpBitcast %i32 %praw
OpReturnValue %pval
OpFunctionEnd

; gdot(row, px, py, pz) = g.x*px + g.y*py + g.z*pz, fused phrase by phrase
; exactly like PerlinProgram::evaluate_with_fma's mul_add chain.
%gdot = OpFunction %f32 None %fn_gdot
%grow = OpFunctionParameter %i32
%gpx = OpFunctionParameter %f32
%gpy = OpFunctionParameter %f32
%gpz = OpFunctionParameter %f32
%glab = OpLabel
%gp = OpFunctionCall %i32 %permute %grow
%gidx = OpBitwiseAnd %i32 %gp %ci15
%ge = OpAccessChain %pV4f %grads %c0i %gidx
%gv = OpLoad %v4f %ge
%gx = OpCompositeExtract %f32 %gv 0
%gy = OpCompositeExtract %f32 %gv 1
%gz = OpCompositeExtract %f32 %gv 2
%gt = OpFMul %f32 %gz %gpz
%gw = OpExtInst %f32 %g Fma %gy %gpy %gt
%gu = OpExtInst %f32 %g Fma %gx %gpx %gw
OpReturnValue %gu
OpFunctionEnd

; fade(v) = v*v*v * fma(v, fma(v, 6, -15), 10)
%fade = OpFunction %f32 None %fn_f32_f32
%fv = OpFunctionParameter %f32
%flab = OpLabel
%f1 = OpExtInst %f32 %g Fma %fv %c6 %cm15
%f2 = OpExtInst %f32 %g Fma %fv %f1 %c10
%fq1 = OpFMul %f32 %fv %fv
%fq2 = OpFMul %f32 %fq1 %fv
%fr = OpFMul %f32 %fq2 %f2
OpReturnValue %fr
OpFunctionEnd

; lerp(delta, start, end) = fma(delta, end - start, start)
%lerp = OpFunction %f32 None %fn_fff
%ld = OpFunctionParameter %f32
%ls = OpFunctionParameter %f32
%le = OpFunctionParameter %f32
%llab = OpLabel
%lsub = OpFSub %f32 %le %ls
%lr = OpExtInst %f32 %g Fma %ld %lsub %ls
OpReturnValue %lr
OpFunctionEnd

; perlin(cell, off, fade_y): one seeded Perlin leaf, fully unrolled.
%perlin = OpFunction %f32 None %fn_perlin
%pcell = OpFunctionParameter %v4i
%poff = OpFunctionParameter %v4f
%pfadey = OpFunctionParameter %f32
%plab2 = OpLabel
%cx = OpCompositeExtract %i32 %pcell 0
%cy = OpCompositeExtract %i32 %pcell 1
%cz = OpCompositeExtract %i32 %pcell 2
%dx = OpCompositeExtract %f32 %poff 0
%dy = OpCompositeExtract %f32 %poff 1
%dz = OpCompositeExtract %f32 %poff 2
%cx1 = OpIAdd %i32 %cx %ci1
%pa = OpFunctionCall %i32 %permute %cx
%pb = OpFunctionCall %i32 %permute %cx1
%pa_cy = OpIAdd %i32 %pa %cy
%pb_cy = OpIAdd %i32 %pb %cy
%pa_cy1 = OpIAdd %i32 %pa_cy %ci1
%pb_cy1 = OpIAdd %i32 %pb_cy %ci1
%lower = OpFunctionCall %i32 %permute %pa_cy
%upper = OpFunctionCall %i32 %permute %pa_cy1
%lowerx = OpFunctionCall %i32 %permute %pb_cy
%upperx = OpFunctionCall %i32 %permute %pb_cy1
%row0 = OpIAdd %i32 %lower %cz
%row1 = OpIAdd %i32 %lowerx %cz
%row2 = OpIAdd %i32 %upper %cz
%row3 = OpIAdd %i32 %upperx %cz
%row4 = OpIAdd %i32 %row0 %ci1
%row5 = OpIAdd %i32 %row1 %ci1
%row6 = OpIAdd %i32 %row2 %ci1
%row7 = OpIAdd %i32 %row3 %ci1
%dx1 = OpFSub %f32 %dx %c1
%dy1 = OpFSub %f32 %dy %c1
%dz1 = OpFSub %f32 %dz %c1
%v0 = OpFunctionCall %f32 %gdot %row0 %dx %dy %dz
%v1 = OpFunctionCall %f32 %gdot %row1 %dx1 %dy %dz
%v2 = OpFunctionCall %f32 %gdot %row2 %dx %dy1 %dz
%v3 = OpFunctionCall %f32 %gdot %row3 %dx1 %dy1 %dz
%v4 = OpFunctionCall %f32 %gdot %row4 %dx %dy %dz1
%v5 = OpFunctionCall %f32 %gdot %row5 %dx1 %dy %dz1
%v6 = OpFunctionCall %f32 %gdot %row6 %dx %dy1 %dz1
%v7 = OpFunctionCall %f32 %gdot %row7 %dx1 %dy1 %dz1
%fx = OpFunctionCall %f32 %fade %dx
%fy = OpFunctionCall %f32 %fade %pfadey
%fz = OpFunctionCall %f32 %fade %dz
; x first (values are indexed with x varying fastest), then y, then z.
%la0 = OpFunctionCall %f32 %lerp %fx %v0 %v1
%la1 = OpFunctionCall %f32 %lerp %fx %v2 %v3
%lb0 = OpFunctionCall %f32 %lerp %fx %v4 %v5
%lb1 = OpFunctionCall %f32 %lerp %fx %v6 %v7
%lc0 = OpFunctionCall %f32 %lerp %fy %la0 %la1
%lc1 = OpFunctionCall %f32 %lerp %fy %lb0 %lb1
%pres = OpFunctionCall %f32 %lerp %fz %lc0 %lc1
OpReturnValue %pres
OpFunctionEnd

; spline(x) for x0=-2, x1=2, y0=-0.75, y1=0.875, d0=0.125, d1=-0.25
%spline = OpFunction %f32 None %fn_f32_f32
%sx = OpFunctionParameter %f32
%slab = OpLabel
%swidth = OpFSub %f32 %c2 %cm2
%snum = OpFSub %f32 %sx %cm2
%salpha = OpFDiv %f32 %snum %swidth
%sdelta = OpFSub %f32 %c0875 %cm075
%snegdelta = OpFNegate %f32 %sdelta
%sleft = OpExtInst %f32 %g Fma %c0125 %swidth %snegdelta
%snegd1 = OpFNegate %f32 %cm025
%sright = OpExtInst %f32 %g Fma %snegd1 %swidth %sdelta
%slinear = OpExtInst %f32 %g Fma %salpha %sdelta %cm075
%srl = OpFSub %f32 %sright %sleft
%scorr = OpExtInst %f32 %g Fma %salpha %srl %sleft
%s1ma = OpFSub %f32 %c1 %salpha
%st = OpFMul %f32 %salpha %s1ma
%sres = OpExtInst %f32 %g Fma %st %scorr %slinear
OpReturnValue %sres
OpFunctionEnd

%main = OpFunction %void None %fnv
%mlab = OpLabel
%gidv = OpLoad %v3u %gid
%ix = OpCompositeExtract %u32 %gidv 0
%inb = OpULessThan %bool %ix %uN
OpSelectionMerge %merge None
OpBranchConditional %inb %body %merge
%body = OpLabel
%pti = OpBitcast %i32 %ix
%cellp = OpAccessChain %pV4i %points %c0i %pti %c0i
%cell = OpLoad %v4i %cellp
%offp = OpAccessChain %pV4f %points %c0i %pti %ci1
%off = OpLoad %v4f %offp
%fyp = OpAccessChain %pF32 %points %c0i %pti %ci2
%fyv = OpLoad %f32 %fyp
%ampp = OpAccessChain %pF32 %points %c0i %pti %ci3
%amp = OpLoad %f32 %ampp

; R1: the seeded Perlin leaf itself.
%r1 = OpFunctionCall %f32 %perlin %cell %off %fyv

; R2 alpha 0 / 0.375 / 1 of blend(alpha, leaf, -0.25).
%r2zero = OpCopyObject %f32 %r1
%r2one = OpCopyObject %f32 %cm025
%r2diff = OpFSub %f32 %cm025 %r1
%r2mid = OpExtInst %f32 %g Fma %c0375 %r2diff %r1

; R3: one cubic spline segment over the leaf.
%r3 = OpFunctionCall %f32 %spline %r1

; R4: the leaf of the sample shifted by (0.375, -0.25, 0.75).
%ox = OpCompositeExtract %f32 %off 0
%oy = OpCompositeExtract %f32 %off 1
%oz = OpCompositeExtract %f32 %off 2
%shx = OpFAdd %f32 %ox %c0375
%shy = OpFAdd %f32 %oy %cm025
%shz = OpFAdd %f32 %oz %c075
%flx = OpExtInst %f32 %g Floor %shx
%fly = OpExtInst %f32 %g Floor %shy
%flz = OpExtInst %f32 %g Floor %shz
%cix = OpConvertFToS %i32 %flx
%ciy = OpConvertFToS %i32 %fly
%ciz = OpConvertFToS %i32 %flz
%cfx = OpConvertSToF %f32 %cix
%cfy = OpConvertSToF %f32 %ciy
%cfz = OpConvertSToF %f32 %ciz
%sox = OpFSub %f32 %shx %cfx
%soy = OpFSub %f32 %shy %cfy
%soz = OpFSub %f32 %shz %cfz
%mcx = OpCompositeExtract %i32 %cell 0
%mcy = OpCompositeExtract %i32 %cell 1
%mcz = OpCompositeExtract %i32 %cell 2
%ncx = OpIAdd %i32 %mcx %cix
%ncy = OpIAdd %i32 %mcy %ciy
%ncz = OpIAdd %i32 %mcz %ciz
%ncell0 = OpCompositeInsert %v4i %ncx %cell 0
%ncell1 = OpCompositeInsert %v4i %ncy %ncell0 1
%ncell = OpCompositeInsert %v4i %ncz %ncell1 2
%noff0 = OpCompositeInsert %v4f %sox %off 0
%noff1 = OpCompositeInsert %v4f %soy %noff0 1
%noff = OpCompositeInsert %v4f %soz %noff1 2
%r4 = OpFunctionCall %f32 %perlin %ncell %noff %soy

; R5: blend(0.375, leaf + 0.125, leaf * -0.5).
%r5a = OpFAdd %f32 %r1 %c0125
%r5b = OpFMul %f32 %r1 %cm05
%r5diff = OpFSub %f32 %r5b %r5a
%r5 = OpExtInst %f32 %g Fma %c0375 %r5diff %r5a

; R6: the trivial router's final_density, 0.125 + 0.125.
%r6 = OpFAdd %f32 %c0125 %c0125

%base = OpShiftLeftLogical %u32 %ix %u3
%o0i = OpIAdd %u32 %base %u0
%o1i = OpIAdd %u32 %base %u1
%o2i = OpIAdd %u32 %base %u2
%o3i = OpIAdd %u32 %base %u3
%o4i = OpIAdd %u32 %base %u4
%o5i = OpIAdd %u32 %base %u5
%o6i = OpIAdd %u32 %base %u6
%o7i = OpIAdd %u32 %base %u7
%m0 = OpFMul %f32 %amp %r1
%m1 = OpFMul %f32 %amp %r2zero
%m2 = OpFMul %f32 %amp %r2mid
%m3 = OpFMul %f32 %amp %r2one
%m4 = OpFMul %f32 %amp %r3
%m5 = OpFMul %f32 %amp %r4
%m6 = OpFMul %f32 %amp %r5
%m7 = OpFMul %f32 %amp %r6
%e0 = OpAccessChain %pF32 %output %c0i %o0i
OpStore %e0 %m0
%e1 = OpAccessChain %pF32 %output %c0i %o1i
OpStore %e1 %m1
%e2 = OpAccessChain %pF32 %output %c0i %o2i
OpStore %e2 %m2
%e3 = OpAccessChain %pF32 %output %c0i %o3i
OpStore %e3 %m3
%e4 = OpAccessChain %pF32 %output %c0i %o4i
OpStore %e4 %m4
%e5 = OpAccessChain %pF32 %output %c0i %o5i
OpStore %e5 %m5
%e6 = OpAccessChain %pF32 %output %c0i %o6i
OpStore %e6 %m6
%e7 = OpAccessChain %pF32 %output %c0i %o7i
OpStore %e7 %m7
OpBranch %merge
%merge = OpLabel
OpReturn
OpFunctionEnd
