+            | GraphNode::Cache(_)
+            | GraphNode::Slice { .. }
+            | GraphNode::Interpolated { .. }
+            | GraphNode::Surface { .. } => Err(unsupported(
+                graph_node_name(node),
+                ProgramExportReason::NeedsContext,
+            )),
+            GraphNode::Spline(_) => Err(unsupported(
