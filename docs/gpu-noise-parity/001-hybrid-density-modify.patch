+                        ProgramExportReason::UnsupportedOperation,
+                    )),
+                }
+            }
+            GraphNode::Lerp {
+                alpha,
+                first,
+                second,
+            } => Ok(DensityProgram::Lerp {
+                alpha: Box::new(self.try_export_to_program(*alpha)?),
+                first: Box::new(self.try_export_to_program(*first)?),
