+```sh
+set -eu
+cargo run -p horizon-client-lib --example wgpu_adapter_inventory
+for probe in \
+  wgpu_perlin_probe \
+  wgpu_lattice_probe \
+  wgpu_density_interp_probe \
+  wgpu_density_graph_probe \
+  wgpu_sqrt_probe
+do
+  WGPU_BACKEND=vulkan WGPU_POWER_PREF=high \
+    cargo run -p horizon-client-lib --example "$probe"
+done
+```
