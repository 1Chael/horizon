+#[repr(C)]
+#[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
+struct Case {
+    corners: [f32; 8],
+    axis_alpha: [f32; 4],
+    blend: [f32; 4],
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, bytemuck::Pod, bytemuck::Zeroable)]
+struct ResultRow {
+    trilinear: f32,
+    blended: f32,
+    pad: [f32; 2],
+}
